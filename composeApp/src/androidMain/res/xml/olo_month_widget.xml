<?xml version="1.0" encoding="utf-8"?>
<!-- W2 month widget (docs/09 §3): 4×4 by default, 4×3 up to 5×5. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_month_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:configure="app.olo.calendar.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:previewLayout="@layout/widget_preview_month"
    android:previewImage="@drawable/widget_preview_month"
    android:minWidth="250dp"
    android:minHeight="160dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="160dp"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:maxResizeWidth="530dp"
    android:maxResizeHeight="530dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
